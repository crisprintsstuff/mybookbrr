[Unit]
Description=MyBookBRR MAM auto-snatch API + UI
After=network.target

[Service]
Type=simple
# Adjust WorkingDirectory and EnvironmentFile to your install path.
WorkingDirectory=%h/mybookbrr
ExecStart=/usr/bin/node dist/server.js
Restart=always
RestartSec=5
TimeoutStopSec=30
KillMode=mixed
Environment=NODE_ENV=production
EnvironmentFile=-%h/mybookbrr/.env
# Optional: enable “Back to Hub” in the UI by rebuilding the client with:
#   VITE_HUB_URL=https://your-hub.example.com npm run build:client
StandardOutput=append:%h/mybookbrr/data/mybookbrr.log
StandardError=append:%h/mybookbrr/data/mybookbrr.log
NoNewPrivileges=true
PrivateTmp=true
LimitNOFILE=65535
MemoryMax=512M

[Install]
WantedBy=default.target
