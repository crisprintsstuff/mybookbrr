PORT=7480
HOST=0.0.0.0
DATA_DIR=./data
DOWNLOADS_DIR=./downloads

# Bootstrap only: used once when no users exist to create the first admin.
# After that, sign in with the admin username/password stored in SQLite.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=changeme
# AUTH_PASSWORD is still accepted as an alias for BOOTSTRAP_ADMIN_PASSWORD.

# Cookie sessions (UI)
# Behind Cloudflare HTTPS, set both:
COOKIE_SECURE=true
TRUST_PROXY=true
SESSION_TTL_DAYS=7

# Discord OAuth (same Discord app as OmegaBot portal)
# If DISCORD_CLIENT_ID / SECRET / ALLOWED_USER_IDS are unset, MyBookBRR
# falls back to /home/cris/discordbots/dashboard/auth_config.json
# DISCORD_OAUTH_ENABLED=false
DISCORD_REDIRECT_URI=https://mybookbrr.boznetwork.com/api/auth/discord/callback
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_ALLOWED_USER_IDS=123456789012345678
# Link first Discord login to an existing local user (recommended for solo admin):
DISCORD_LINK_USERNAME=admin
# Role for newly created Discord-only users (ignored when linking):
DISCORD_DEFAULT_ROLE=admin

# Authentik / OIDC (direct IdP login — deeper SSO alongside Hub ticket SSO)
# Create an OIDC provider in Authentik with redirect:
#   https://mybookbrr.boznetwork.com/api/auth/oidc/callback
# Or add that redirect URI to the existing Hub provider and reuse client id/secret.
# OIDC_ENABLED=true
# OIDC_DISCOVERY_URL=https://auth.boznetwork.com/application/o/boz-hub/.well-known/openid-configuration
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://mybookbrr.boznetwork.com/api/auth/oidc/callback
# OIDC_SCOPES=openid profile email groups
# OIDC_DEFAULT_ROLE=admin
# OIDC_ADMIN_GROUPS=authentik Admins,boz-admins
# OIDC_LINK_USERNAME=admin
# OIDC_SYNC_ROLE=true

# Hub ticket SSO (Open from Hub — still supported)
# SSO_SHARED_SECRET=
# HUB_SSO_REDEEM_URL=http://127.0.0.1:5000/api/v1/sso/redeem

# SQLite backups (online copy via better-sqlite3)
# BACKUP_ENABLED=false
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP=7
# BACKUP_DIR=./data/backups

# Optional first-attempt snatch error backoff override (minutes)
# SNATCH_ERROR_BACKOFF_MINUTES=15

# Browser CORS allowlist (comma-separated). Use * only for local debugging.
# CORS_ORIGINS=https://mybookbrr.boznetwork.com,http://127.0.0.1:7480,http://localhost:7480
