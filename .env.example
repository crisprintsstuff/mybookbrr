PORT=7480
HOST=0.0.0.0
DATA_DIR=./data
DOWNLOADS_DIR=./downloads

# Bootstrap only: used once when no users exist to create the first admin.
# After that, sign in with the admin username/password stored in SQLite.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=changeme
# AUTH_PASSWORD is still accepted as an alias for BOOTSTRAP_ADMIN_PASSWORD.

# Cookie sessions (UI)
COOKIE_SECURE=false
SESSION_TTL_DAYS=7

# Optional: prefer COOKIE_SECURE=true behind HTTPS / reverse proxy
# TRUST_PROXY=true
