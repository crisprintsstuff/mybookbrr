PORT=7480
HOST=0.0.0.0
DATA_DIR=./data
DOWNLOADS_DIR=./downloads

# Bootstrap only: used once when no users exist to create the first admin.
# After that, sign in with the admin username/password stored in SQLite.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=changeme
# AUTH_PASSWORD is still accepted as an alias for BOOTSTRAP_ADMIN_PASSWORD.

# Cookie sessions (UI)
# Behind HTTPS reverse proxy / Cloudflare, set both:
COOKIE_SECURE=false
TRUST_PROXY=false
SESSION_TTL_DAYS=7

# ── Discord OAuth (optional) ──────────────────────────────────────────────
# Create a Discord application → OAuth2 redirect:
#   http://127.0.0.1:7480/api/auth/discord/callback
#   https://YOUR.DOMAIN/api/auth/discord/callback
# DISCORD_OAUTH_ENABLED=false
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_REDIRECT_URI=http://127.0.0.1:7480/api/auth/discord/callback
# DISCORD_ALLOWED_USER_IDS=123456789012345678
# Optional JSON fallback (client_id, client_secret, allowed_user_ids) instead of env:
# DISCORD_AUTH_CONFIG=/path/to/discord-auth.json
# Link first Discord login to an existing local user:
# DISCORD_LINK_USERNAME=admin
# DISCORD_DEFAULT_ROLE=admin

# ── OIDC / Authentik (optional) ───────────────────────────────────────────
# Create an OIDC app with redirect:
#   https://YOUR.DOMAIN/api/auth/oidc/callback
# OIDC_ENABLED=false
# OIDC_DISCOVERY_URL=https://auth.example.com/application/o/mybookbrr/.well-known/openid-configuration
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://YOUR.DOMAIN/api/auth/oidc/callback
# OIDC_SCOPES=openid profile email groups
# OIDC_DEFAULT_ROLE=admin
# OIDC_ADMIN_GROUPS=admins
# OIDC_LINK_USERNAME=admin
# OIDC_SYNC_ROLE=true

# ── External control plane ticket SSO (optional) ──────────────────────────
# Shared-secret one-time tickets from a hub/portal. Leave unset for standalone.
# SSO_SHARED_SECRET=
# HUB_SSO_REDEEM_URL=http://127.0.0.1:5000/api/v1/sso/redeem

# SQLite backups (online copy via better-sqlite3)
# BACKUP_ENABLED=true
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP=7
# BACKUP_DIR=./data/backups

# Optional first-attempt snatch error backoff override (minutes)
# SNATCH_ERROR_BACKOFF_MINUTES=15

# Browser CORS allowlist (comma-separated). Defaults to localhost UI ports.
# Add your public origin when reverse-proxying.
# CORS_ORIGINS=https://mybookbrr.example.com,http://127.0.0.1:7480,http://localhost:7480
