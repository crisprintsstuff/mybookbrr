PORT=7480
HOST=0.0.0.0
DATA_DIR=./data
DOWNLOADS_DIR=./downloads

# Bootstrap only: used once when no users exist to create the first admin.
# After that, sign in with the admin username/password stored in SQLite.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=changeme
# AUTH_PASSWORD is still accepted as an alias for BOOTSTRAP_ADMIN_PASSWORD.

# Cookie sessions (UI)
# Behind Cloudflare HTTPS, set both:
COOKIE_SECURE=true
TRUST_PROXY=true
SESSION_TTL_DAYS=7

# Discord OAuth (same Discord app as OmegaBot portal)
# If DISCORD_CLIENT_ID / SECRET / ALLOWED_USER_IDS are unset, MyBookBRR
# falls back to /home/cris/discordbots/dashboard/auth_config.json
# DISCORD_OAUTH_ENABLED=false
DISCORD_REDIRECT_URI=https://mybookbrr.boznetwork.com/api/auth/discord/callback
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_ALLOWED_USER_IDS=123456789012345678
# Link first Discord login to an existing local user (recommended for solo admin):
DISCORD_LINK_USERNAME=admin
# Role for newly created Discord-only users (ignored when linking):
DISCORD_DEFAULT_ROLE=admin
